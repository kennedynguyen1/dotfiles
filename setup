#!/bin/bash
set -euo pipefail

repo=$(cd "$(dirname "$0")" && pwd -P)
config=${XDG_CONFIG_HOME:-$HOME/.config}
zshrc=${ZDOTDIR:-$HOME}/.zshrc
hook='[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/personal.zsh" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/personal.zsh"'

if ! command -v brew >/dev/null; then
  echo "Install Homebrew from https://brew.sh, follow its shellenv instructions, then rerun ./setup." >&2
  exit 1
fi

# Keep two setup runs from racing to install the same files.
lock="$HOME/.dotfiles-setup.lock"
if ! /usr/bin/shlock -p "$$" -f "$lock"; then
  echo "Another setup is running, or the setup lock is inaccessible: $lock" >&2
  exit 1
fi
trap 'rm -f "$lock"' EXIT

sources=("$repo/zsh/p10k.zsh" "$repo/ghostty/config" "$repo/zsh/personal.zsh" "$repo/nvim")
targets=("$HOME/.p10k.zsh" "$config/ghostty/config" "$config/zsh/personal.zsh" "$config/nvim")

# Inspect every destination before installing or linking anything.
for i in "${!targets[@]}"; do
  target=${targets[i]}
  source_file=${sources[i]}
  if [[ -L "$target" ]]; then
    if [[ "$target" -ef "$source_file" ]]; then continue; fi
    echo "Existing link points elsewhere: $target -> $(readlink "$target")" >&2
    exit 1
  elif [[ -d "$source_file" && -e "$target" ]]; then
    echo "Back up $target outside that path, then rerun ./setup to link $source_file." >&2
    exit 1
  elif [[ -f "$target" ]]; then
    if ! cmp -s "$target" "$source_file"; then
      printf 'Setup stopped. To compare the files locally, run:\n  diff -u %q %q\n' "$target" "$source_file" >&2
      exit 1
    fi
  elif [[ -e "$target" ]]; then
    echo "Expected a file at $target. Move it aside before setup." >&2
    exit 1
  fi
done
if [[ -e "$zshrc" || -L "$zshrc" ]]; then
  [[ -f "$zshrc" ]] || { echo "Inspect $zshrc before setup." >&2; exit 1; }
fi

brew bundle check --no-upgrade --file="$repo/Brewfile" >/dev/null || brew bundle install --no-upgrade --file="$repo/Brewfile"

for i in "${!targets[@]}"; do
  target=${targets[i]}
  [[ -L "$target" && "$target" -ef "${sources[i]}" ]] && continue
  mkdir -p "$(dirname "$target")"
  ln -shf "${sources[i]}" "$target"
  echo "Linked $target"
done

if ! grep -Fqx "$hook" "$zshrc" 2>/dev/null; then
  mkdir -p "$(dirname "$zshrc")"
  if [[ ! -s "$zshrc" ]]; then
    cat >> "$zshrc" <<'ZSH'
# Start the cached Powerlevel10k prompt early in a fresh shell.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
ZSH
  fi
  printf '\n%s\n' "$hook" >> "$zshrc"
  echo "Enabled personal shell settings in $zshrc"
fi
